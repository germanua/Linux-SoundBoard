[Unit]
Description=Linux Soundboard audio engine
Documentation=https://github.com/germanua/Linux-SoundBoard
After=pipewire.service pipewire-pulse.service wireplumber.service pulseaudio.service
PartOf=linux-soundboard-engine.target
RefuseManualStop=yes
StartLimitIntervalSec=60
StartLimitBurst=5
X-LinuxSoundBoard-Managed=true

[Service]


Type=exec
ExecStart=linux-soundboard --audio-engine
Restart=on-failure
RestartSec=2s


RestartPreventExitStatus=2




NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
