post_install() {
  echo "==> Linux Soundboard supports native Wayland and X11 sessions."
  echo "==> Use Linux Soundboard's Install swhkd button for the pinned managed Wayland daemon."

  if command -v systemctl >/dev/null 2>&1; then
    systemctl --global disable linux-soundboard-engine.service >/dev/null 2>&1 || true
    systemctl --global enable linux-soundboard-engine.target >/dev/null 2>&1 || true
    echo "==> Enabled Linux Soundboard audio engine for user sessions."
  fi

  echo "==> X11 sessions can use the native X11 backend directly."
}

post_upgrade() {
  post_install
}
